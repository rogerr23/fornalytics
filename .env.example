# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# --- IA em execução ---
# Provedor ativo: gemini | ollama (troca manual, sem fallback automático). Guia: docs/llm.md
LLM_PROVIDER=gemini
# Chave gratuita em https://aistudio.google.com/apikey (não pede cartão)
GEMINI_API_KEY=
# Modelo Flash do plano gratuito. "npm run llm:models" lista os disponíveis para a sua chave.
GEMINI_MODEL=gemini-3.5-flash
# Só se for usar o Ollama local (https://ollama.com). Ex.: OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Banco (Neon) ---
# Cole as URLs como o Neon entrega (postgresql://...). Passo a passo no README.
# Neon > Connect > "Connection pooling" LIGADO (endereço com -pooler). Usada pela aplicação.
DATABASE_URL=
# Neon > Connect > "Connection pooling" DESLIGADO. Usada pelo Alembic (migrações).
DATABASE_URL_DIRECT=
# Branch "test" do Neon, pooled. Só para testes de integração; vazio = testes de banco pulados.
TEST_DATABASE_URL=

# --- Limites de contexto ---
# Aviso quando o material passar deste total de tokens
MAX_CONTEXT_TOKENS=500000
# Chat: máximo de arquivos e de tokens enviados por pergunta
CHAT_MAX_FILES=8
CHAT_CONTEXT_TOKENS=30000

# --- Limites de upload ---
MAX_UPLOAD_MB=20
MAX_UNZIPPED_MB=100
MAX_FILES=2000

# --- Servidor ---
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
