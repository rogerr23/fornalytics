# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# --- IA em execução ---
# Provedor ativo: gemini | ollama (troca manual, sem fallback automático)
LLM_PROVIDER=gemini
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use um modelo Flash disponível no plano gratuito (confira a lista no AI Studio)
GEMINI_MODEL=
# Só se for usar o Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Banco (Neon) ---
# Conexão pooled (usada pela aplicação)
DATABASE_URL=
# Conexão direta (usada pelo Alembic)
DATABASE_URL_DIRECT=
# Branch de teste do Neon (só para testes de integração)
TEST_DATABASE_URL=

# --- Limites de contexto ---
# Aviso quando o material passar deste total de tokens
MAX_CONTEXT_TOKENS=500000
# Chat: máximo de arquivos e de tokens enviados por pergunta
CHAT_MAX_FILES=8
CHAT_CONTEXT_TOKENS=30000

# --- Limites de upload ---
MAX_UPLOAD_MB=20
MAX_UNZIPPED_MB=100
MAX_FILES=2000

# --- Servidor ---
# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
